<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers" (signing request 2 in .github/workflows/release.yml).
  SignPath doesn't read this file from the repository: paste it into the SignPath project
  (Artifact configurations > installers) and keep the two in sync.

  Input: the GitHub artifact "yonder-installers-unsigned", a ZIP with both installers at its root.
  The yonder.exe inside them was already signed by the "exe" configuration before `tauri bundle`
  packed it, so this configuration only signs the outer files. SignPath can't open NSIS
  installers, which is why the exe is signed in a separate request first.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <!-- NSIS installer -->
    <pe-file path="Yonder_${version}_x64-setup.exe" product-name="Yonder" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
    <!-- WiX installer -->
    <msi-file path="Yonder_${version}_x64_en-US.msi" subject="Yonder">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
