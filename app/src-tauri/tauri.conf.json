{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yonder",
  "version": "1.0.7",
  "identifier": "app.yonder.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["yonder"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A tiny break reminder for healthier screen habits",
    "longDescription": "Yonder reminds you to rest your eyes, fix your posture and take regular breaks — without breaking your flow. Free and open source.",
    "copyright": "MIT License — Yonder contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
